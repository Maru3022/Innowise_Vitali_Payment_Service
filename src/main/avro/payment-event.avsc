{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.example.events",
  "fields": [
    { "name": "paymentId", "type": "string" },
    { "name": "orderId", "type": "string" },
    { "name": "userId", "type": "string" },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "PaymentStatus",
        "symbols": ["PENDING", "SUCCESS", "FAILED", "REJECTED"]
      }
    }
  ]
}
