<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.28.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb.xsd">

    <changeSet id="1" author="vitali-artyomchik">
        <mongodb:createCollection collectionName="payments"/>
    </changeSet>

    <changeSet id="2" author="vitali-artyomchik">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "order_id": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_order_id" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="3" author="vitali-artyomchik">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "user_id": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_user_id" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="4" author="vitali-artyomchik">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "status": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_status" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="5" author="vitali-artyomchik">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "timestamp": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_timestamp" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="6" author="vitali-artyomchik">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "user_id": 1, "timestamp": 1, "payment_amount": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_user_id_timestamp_payment_amount" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>